# وش ذا؟ — Firebase configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values from:
#   Firebase Console -> Project settings -> General -> Your apps -> Web app
#
# Before the app will run you must enable, in the Firebase Console:
#   1. Authentication -> Sign-in method -> Anonymous  (required)
#   2. Realtime Database -> Create database           (required)
#
# Then publish the security rules:
#   firebase deploy --only database
#
# NOTE: these values are public by design — a Firebase web config is not a
# secret. What protects the game is `firebase/database.rules.json`, not this
# file. Never add a service-account key or an Admin SDK credential here; those
# belong in Cloud Functions config only.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to point the app at the local emulators instead of the cloud.
# Run them with: npm run emulators
VITE_USE_FIREBASE_EMULATORS=false

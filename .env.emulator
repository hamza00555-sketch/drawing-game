# وش ذا؟ — تشغيل محلي بالكامل على المحاكي، بلا مشروع Firebase وبلا بطاقة.
# -----------------------------------------------------------------------------
# لا تنسخ هذا الملف يدويًا — شغّل:
#
#   npm run setup:emulator
#
# (يكتب `.env.local` ويثبّت اعتماديات functions، ويعمل على Windows أيضًا حيث
#  `cp` ليست أمرًا في CMD.)
#
# ثم في طرفيتين:
#
#   npm run emulators        # Auth + Realtime Database + Functions
#   npm run dev
#
# القيم هنا وهمية عن قصد. المحاكي لا يتحقق منها إطلاقًا — وجودها مطلوب فقط لأن
# التطبيق يرفض الإقلاع بإعداد ناقص، وهو سلوك مقصود: شاشة إعداد صريحة أفضل من
# فشل غامض في أول استدعاء.
#
# اسم المشروع يبدأ بـ`demo-` عمدًا. هذه البادئة تجعل المحاكي يعمل بلا اتصال
# وبلا اعتماد سحابي؛ أي اسم آخر سيحاول الوصول إلى مشروع حقيقي.

VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-wesh-tha.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=http://127.0.0.1:9000?ns=demo-wesh-tha
VITE_FIREBASE_PROJECT_ID=demo-wesh-tha
VITE_FIREBASE_STORAGE_BUCKET=demo-wesh-tha.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=demo-app

VITE_USE_FIREBASE_EMULATORS=true

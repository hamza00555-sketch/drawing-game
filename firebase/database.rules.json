{
  // وش ذا؟ — Realtime Database Security Rules
  // ---------------------------------------------------------------------------
  // These rules are part of the architecture, not a hardening pass bolted on
  // afterwards. The game's core secret — which player is the impostor and what
  // the word is — is protected HERE, not in the UI.
  //
  // Trust model:
  //   - Clients may write only what they legitimately own: their own player
  //     record, their own presence, their own vote, their own guess, their own
  //     strokes while it is their turn.
  //   - Scores, phases, turn order, roles and words are written exclusively by
  //     trusted server logic (Cloud Functions via the Admin SDK, which bypasses
  //     these rules). Every such node is `".write": false` for clients.
  //   - The one deliberate exception is host migration: a connected player may
  //     claim host ONLY when the current host is provably disconnected. This
  //     avoids a Cloud Function on a latency-sensitive path.

  "rules": {
    ".read": false,
    ".write": false,

    // Lookup index: join code -> roomId. Readable so a player can resolve a
    // code before they are a member. Write-once, and only by the room creator.
    "roomCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.isString() && newData.val().length > 0 && root.child('rooms').child(newData.val()).child('hostId').val() === auth.uid"
      }
    },

    "rooms": {
      "$roomId": {
        // Any authenticated user may read a room they are about to join.
        ".read": "auth != null",
        // Created by its host; afterwards only specific children are writable.
        ".write": "auth != null && !data.exists() && newData.child('hostId').val() === auth.uid",

        "code": { ".validate": "newData.isString()" },
        "createdAt": { ".validate": "newData.val() === now" },
        "status": { ".validate": "newData.isString()" },

        "hostId": {
          // Host migration: writable only when the current host is offline and
          // the claimant is a connected member of this room. Clients pick the
          // oldest connected player; a race resolves to last-write-wins, which
          // is harmless because every candidate is a valid host.
          ".write": "auth != null && root.child('presence').child($roomId).child(data.val()).child('connected').val() === false && root.child('presence').child($roomId).child(auth.uid).child('connected').val() === true",
          // The membership requirement applies to CHANGING the host, not to
          // setting it the first time. A room is created before anyone can be a
          // player in it — the player record is written afterwards — so
          // demanding membership here rejected every room at creation.
          ".validate": "newData.isString() && (!data.exists() || root.child('roomPlayers').child($roomId).child(newData.val()).exists())"
        },

        "currentMode": {
          // Only the host chooses the mode, and only while nobody is playing.
          ".write": "auth != null && root.child('rooms').child($roomId).child('hostId').val() === auth.uid && !root.child('games').child($roomId).child('current').exists()",
          ".validate": "newData.isString() && newData.val().matches(/^(mozawwer|kammil|mamnou3at|mushtarak|kanatEsh)$/)"
        },

        // Live playtest tuning. Host-only, and locked while a game is running
        // so balance cannot be changed mid-round to influence an outcome.
        "settings": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('hostId').val() === auth.uid && !root.child('games').child($roomId).child('current').exists()"
        }
      }
    },

    // Character reservations: characterId -> playerId. Uniqueness is enforced
    // here, by the database, rather than in the UI. A node may be written only
    // when it is free or already yours, so two players claiming the same
    // character simultaneously cannot both succeed — one transaction wins and
    // the other is rejected.
    "roomCharacters": {
      "$roomId": {
        ".read": "auth != null",

        "$characterId": {
          ".write": "auth != null && (!data.exists() || data.val() === auth.uid) && (!newData.exists() || newData.val() === auth.uid)",
          ".validate": "newData.isString() && newData.val() === auth.uid"
        }
      }
    },

    "roomPlayers": {
      "$roomId": {
        ".read": "auth != null",
        ".indexOn": ["joinedAt"],

        "$playerId": {
          // A player owns their own record and nobody else's. Note that score
          // is NOT stored here — see `playerScores` — precisely so that this
          // node can stay self-writable.
          ".write": "auth != null && auth.uid === $playerId && (root.child('rooms').child($roomId).exists())",
          ".validate": "newData.hasChildren(['name', 'characterId', 'joinedAt'])",

          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16" },
          // You may only present as a character you actually hold the
          // reservation for. Without this a client could skip the transaction
          // and simply write any characterId onto its own player record.
          "characterId": {
            ".validate": "newData.isString() && newData.val().length <= 40 && root.child('roomCharacters').child($roomId).child(newData.val()).val() === auth.uid"
          },
          "variant": { ".validate": "newData.isString() && newData.val().length <= 24" },
          "ready": { ".validate": "newData.isBoolean()" },
          "joinedAt": { ".validate": "newData.val() === now || data.val() === newData.val()" },
          "$other": { ".validate": false }
        }
      }
    },

    // Scores are server-authoritative. A client can read the scoreboard but can
    // never write to it — this is what stops a player awarding themselves points.
    "playerScores": {
      "$roomId": {
        ".read": "auth != null",
        ".write": false
      }
    },

    "presence": {
      "$roomId": {
        ".read": "auth != null",
        "$playerId": {
          // Written by the client and by its onDisconnect handler.
          ".write": "auth != null && auth.uid === $playerId",
          "connected": { ".validate": "newData.isBoolean()" },
          "lastSeen": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },

    // Game state: readable by members, writable only by trusted logic. This is
    // what prevents a player from forcing a phase change, skipping a turn,
    // extending their own timer or making themselves the active player.
    //
    // BECAUSE this subtree is readable by every member, nothing secret may be
    // stored in it. Read rules in Realtime Database cascade downwards and cannot
    // be revoked further down the tree, so a single secret child here would be
    // world-readable to the room no matter what rule sat beneath it. The word,
    // the impostor, the forbidden list, the split prompt and the seed sentence
    // therefore live in `gameSecrets` below, and are copied into this node only
    // once the round has revealed them.
    "games": {
      "$roomId": {
        ".read": "auth != null && root.child('roomPlayers').child($roomId).child(auth.uid).exists()",
        ".write": false
      }
    },

    // Round facts no client may ever read: the word, who the impostor is, the
    // two halves of a split prompt, the taboo list, the seed sentence. Trusted
    // logic reads and writes these through the Admin SDK, which bypasses rules;
    // for every client this subtree simply does not exist.
    //
    // This is the same principle as `playerSecrets`, one level up: there, a
    // player reads their own payload; here, nobody reads anything.
    "gameSecrets": {
      ".read": false,
      ".write": false
    },

    // The heart of المزوّر. A player can read ONLY their own secret payload.
    // The impostor's payload has no `word` child at all — the word never
    // reaches their device, so there is nothing to uncover in DevTools.
    "playerSecrets": {
      "$roomId": {
        "$gameId": {
          "$playerId": {
            ".read": "auth != null && auth.uid === $playerId",
            ".write": false
          }
        }
      }
    },

    "strokes": {
      "$roomId": {
        "$gameId": {
          ".read": "auth != null && root.child('roomPlayers').child($roomId).child(auth.uid).exists()",
          ".indexOn": ["seq"],

          "$strokeId": {
            // A stroke may only be written by its own author, only while a
            // drawing phase is live, and only if that author is either the
            // active player (turn-based modes) or listed as an active drawer
            // (simultaneous modes such as الرسم المشترك).
            //
            // A stroke is not one write. The header goes out on pointer-down,
            // point chunks are appended every ~50ms, and `done` lands on
            // pointer-up — so this rule must permit the author to keep writing
            // to a node that already exists. What it must NOT permit is one
            // player appending to another player's line, or anyone drawing
            // outside their own turn, and both of those are still refused.
            ".write": "auth != null && newData.child('playerId').val() === auth.uid && (!data.exists() || data.child('playerId').val() === auth.uid) && root.child('games').child($roomId).child('current').child('phase').val().matches(/^draw/) && (root.child('games').child($roomId).child('current').child('currentPlayerId').val() === auth.uid || root.child('games').child($roomId).child('current').child('activeDrawers').child(auth.uid).exists())",
            ".validate": "newData.hasChildren(['playerId', 'seq', 'tool', 'color', 'width', 'points', 'startedAt'])",

            "playerId": { ".validate": "newData.val() === auth.uid" },
            "seq": { ".validate": "newData.isNumber()" },
            "tool": { ".validate": "newData.isString() && newData.val().matches(/^(pen|eraser)$/)" },
            "color": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "width": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 1" },
            "points": { ".validate": "newData.hasChildren()" },
            "startedAt": { ".validate": "newData.isNumber()" },
            // Written at pointer-up so viewers know the line is complete.
            "done": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        }
      }
    },

    // كانت إيش؟ draws into its OWN bucket per link, not into the shared
    // `strokes` node above.
    //
    // The reason is the mode's only secret. `strokes/{roomId}/{gameId}` is
    // readable by every member — correct for the four modes where everyone is
    // looking at one canvas together, and fatal here, where it would let a
    // player read every earlier drawing in the chain and reason backwards to the
    // original sentence. So each link's strokes sit behind the same `visibleTo`
    // grant that gates the link text itself, and a player may read exactly two
    // things: the link feeding their turn, and the one they are drawing now.
    "linkStrokes": {
      "$roomId": {
        "$gameId": {
          "$index": {
            ".read": "auth != null && (root.child('games').child($roomId).child('current').child('phase').val().matches(/^(reveal|result)/) || root.child('games').child($roomId).child('current').child('visibleTo').child($index).child(auth.uid).exists() || (root.child('games').child($roomId).child('current').child('currentPlayerId').val() === auth.uid && root.child('games').child($roomId).child('current').child('currentIndexKey').val() === $index))",
            ".indexOn": ["seq"],

            "$strokeId": {
              // Only the player whose turn it is, only into the link they are
              // authoring right now, and only while the chain is running.
              ".write": "auth != null && !data.exists() && newData.child('playerId').val() === auth.uid && root.child('games').child($roomId).child('current').child('phase').val() === 'turn' && root.child('games').child($roomId).child('current').child('currentPlayerId').val() === auth.uid && root.child('games').child($roomId).child('current').child('currentIndexKey').val() === $index",
              ".validate": "newData.hasChildren(['playerId', 'seq', 'tool', 'color', 'width', 'points', 'startedAt'])",

              "playerId": { ".validate": "newData.val() === auth.uid" },
              "seq": { ".validate": "newData.isNumber()" },
              "tool": { ".validate": "newData.isString() && newData.val().matches(/^(pen|eraser)$/)" },
              "color": { ".validate": "newData.isString() && newData.val().length <= 24" },
              "width": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 1" },
              "points": { ".validate": "newData.hasChildren()" },
              "startedAt": { ".validate": "newData.isNumber()" },
              "done": { ".validate": "newData.isBoolean()" },
              "$other": { ".validate": false }
            }
          }
        }
      }
    },

    "votes": {
      "$roomId": {
        "$gameId": {
          // Votes stay sealed until the reveal phase opens them.
          ".read": "auth != null && root.child('games').child($roomId).child('current').child('phase').val().matches(/^(reveal|result)/)",

          "$voterId": {
            // You may only cast your own vote, exactly once, and you cannot
            // change it afterwards.
            ".write": "auth != null && auth.uid === $voterId && !data.exists() && root.child('games').child($roomId).child('current').child('phase').val() === 'vote'",
            ".validate": "newData.isString() && root.child('roomPlayers').child($roomId).child(newData.val()).exists()"
          }
        }
      }
    },

    // Who has voted — never who they voted for.
    //
    // `votes` above stays sealed until the reveal, which is right: a running
    // tally would let the room watch an accusation build and pile on. But a
    // voting screen with no sign of progress reads as broken, so each voter also
    // drops a mark here. It carries a single fact — "this player is done" — and
    // that fact is safe to share.
    "voteMarks": {
      "$roomId": {
        "$gameId": {
          ".read": "auth != null && root.child('roomPlayers').child($roomId).child(auth.uid).exists()",

          "$voterId": {
            ".write": "auth != null && auth.uid === $voterId && !data.exists() && root.child('games').child($roomId).child('current').child('phase').val() === 'vote'",
            ".validate": "newData.isBoolean() && newData.val() === true"
          }
        }
      }
    },

    "guesses": {
      "$roomId": {
        "$gameId": {
          ".read": "auth != null && root.child('roomPlayers').child($roomId).child(auth.uid).exists()",
          ".indexOn": ["at"],

          "$guessId": {
            ".write": "auth != null && !data.exists() && newData.child('playerId').val() === auth.uid && root.child('games').child($roomId).child('current').child('phase').val().matches(/^(draw|guess)/)",
            ".validate": "newData.hasChildren(['playerId', 'text', 'at'])",

            "playerId": { ".validate": "newData.val() === auth.uid" },
            "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
            "at": { ".validate": "newData.val() === now" },
            // Correctness is decided by trusted logic, never claimed by the client.
            "correct": { ".validate": false },
            "rank": { ".validate": false },
            "$other": { ".validate": false }
          }
        }
      }
    },

    // كانت إيش؟ — each link is readable only by the player whose turn it feeds,
    // until the final reveal. This is what keeps the chain blind.
    "chains": {
      "$roomId": {
        "$gameId": {
          "$index": {
            ".read": "auth != null && (root.child('games').child($roomId).child('current').child('phase').val().matches(/^(reveal|result)/) || root.child('games').child($roomId).child('current').child('visibleTo').child($index).child(auth.uid).exists())",
            ".write": "auth != null && !data.exists() && newData.child('playerId').val() === auth.uid && root.child('games').child($roomId).child('current').child('currentPlayerId').val() === auth.uid",
            ".validate": "newData.hasChildren(['type', 'playerId', 'content'])",

            "type": { ".validate": "newData.isString() && newData.val().matches(/^(text|drawing)$/)" },
            "playerId": { ".validate": "newData.val() === auth.uid" },
            "content": { ".validate": "newData.isString() && newData.val().length <= 4000" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
